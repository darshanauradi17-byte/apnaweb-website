# Copy this file to ".env" and set your own values before deploying.

# Port the server runs on
PORT=3000

# Owner dashboard login. Use a long, unique password.
ADMIN_USER=owner
ADMIN_PASS=change-this-to-a-long-unique-password

# Optional: set to 1 when running behind a proxy such as Nginx, Render or Railway,
# so rate limiting sees the visitor's real IP address.
# TRUST_PROXY=1

# Optional: store lead data somewhere other than ./data
# DATA_DIR=/var/data/apnaweb
