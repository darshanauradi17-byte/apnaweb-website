# Copy this file to ".env" and fill it in. NEVER commit the real .env file.
# On a host (Render, Railway, VPS...) set these in the host's environment settings instead.

# ---------------------------------------------------------------------------
# Required: owner dashboard login
# ---------------------------------------------------------------------------
# Pick a username that is not "admin" or "owner" (3+ characters).
ADMIN_USER=

# BEST: a salted hash. Create one with:  npm run hash-password
ADMIN_PASS_HASH=

# OR (less safe): a plain password of 12+ characters. Remove it once you use the hash.
# ADMIN_PASS=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000

# "production" is the default and turns debug behaviour off. Use "development" only on your own computer.
# NODE_ENV=production

# Public address of the site, used for share previews and canonical links. Leave empty until you have a domain.
# SITE_URL=https://your-domain.example

# Set to 1 when the site is behind Nginx, Render, Railway, Cloudflare etc., so rate limits see the visitor's real IP.
# TRUST_PROXY=1

# Set to 1 once HTTPS is on: redirects http to https and tells browsers to stay on https.
# FORCE_HTTPS=1

# ---------------------------------------------------------------------------
# Optional hardening
# ---------------------------------------------------------------------------
# Only these IPs can reach the owner login and dashboard API (comma separated). Empty means anyone with the password.
# ADMIN_ALLOWED_IPS=203.0.113.10

# Extra origins allowed to send form posts (almost always leave empty; the site only talks to itself).
# ALLOWED_ORIGINS=

# Where customer data is stored. Keep it outside the public folder and back it up.
# DATA_DIR=/var/data/brandx

# ---------------------------------------------------------------------------
# Optional: AI assistant (hidden unless a key is set). The key stays on the server and is never sent to the browser.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AI_DAILY_LIMIT=300
